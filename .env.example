# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored, so secrets never get committed.
# In production the same names come from your hosting provider's environment
# (Vercel → Project → Settings → Environment Variables).

# --- Supabase (your own project: Settings → API) ---
# The VITE_ names are inlined into the browser bundle; the bare names are read
# by server functions. vite.config.ts mirrors one set onto the other locally.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"
# Server-only. Bypasses RLS — never expose to the browser, never prefix VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- App origin ---
# Pins the OAuth redirect URI Google must match byte for byte. Leave empty
# locally to use the request origin.
PUBLIC_APP_URL="https://your-domain.com"

# --- Azure AI Foundry (screening, memos, pass emails, deal chat) ---
# Endpoint: https://<resource>.openai.azure.com  (a trailing /openai or /models is stripped automatically)
AZURE_FOUNDRY_ENDPOINT=""
AZURE_FOUNDRY_API_KEY=""
AZURE_FOUNDRY_DEPLOYMENT="gpt-4.1"

# --- Azure AI Document Intelligence (deck / document extraction) ---
# Endpoint: https://<resource>.cognitiveservices.azure.com
AZURE_DOC_INTELLIGENCE_ENDPOINT=""
AZURE_DOC_INTELLIGENCE_KEY=""

# --- Google OAuth (Gmail deal inbox) ---
# Google Cloud console → Credentials → OAuth client ID → Web application.
# Authorized redirect URI: <PUBLIC_APP_URL>/oauth/gmail/return
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Encryption key for stored provider refresh tokens ---
# Generate once: openssl rand -base64 32
# Also signs the OAuth `state` parameter. Rotating it forces every user to
# reconnect Gmail.
APP_USER_CONNECTION_KEY_SECRET=""

# --- Polar billing ---
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SERVER="sandbox"

# --- Notes ---
# Auth emails (signup confirm, password reset, invites) are sent by Supabase
# Auth, not by this app. Configure the sender in the Supabase dashboard:
# Authentication → Emails → SMTP Settings (Resend, SES, Postmark, …).
# Google sign-in is likewise configured in Supabase: Authentication → Providers
# → Google, plus URL Configuration → Redirect URLs.
