# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored, so secrets never get committed.
# In production the same names come from your hosting provider's environment
# (Vercel → Project → Settings → Environment Variables).

# --- Supabase (your own project: Settings → API) ---
# The VITE_ names are inlined into the browser bundle; the bare names are read
# by server functions. vite.config.ts mirrors one set onto the other locally.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"
# Server-only. Bypasses RLS — never expose to the browser, never prefix VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- App origins ---
# Allowlist of origins this deployment may send an OAuth callback to. Google
# matches the redirect URI byte for byte, so each origin gets its own.
#
# Comma-separated: one value covers production and staging, and the request's
# own hostname decides which is used — no per-environment editing. A loopback
# request always overrides this, so a deployed value here never affects local
# dev. An unrecognised Host falls back to the FIRST entry, so put production
# first.
PUBLIC_APP_URL="https://www.baseerah.dev,https://test.baseerah.dev"

# Gmail connect refuses to run against localhost by default — OAuth is tested on
# a deployed staging origin (see docs/development-workflow.md). Set to "true"
# only after registering http://localhost:3000/oauth/gmail/return with Google.
ALLOW_LOCAL_OAUTH=""

# --- Azure AI Foundry (screening, memos, pass emails, deal chat) ---
# Endpoint: https://<resource>.openai.azure.com  (a trailing /openai or /models is stripped automatically)
AZURE_FOUNDRY_ENDPOINT=""
AZURE_FOUNDRY_API_KEY=""
AZURE_FOUNDRY_DEPLOYMENT="gpt-4.1"

# --- Azure AI Document Intelligence (deck / document extraction) ---
# Endpoint: https://<resource>.cognitiveservices.azure.com
AZURE_DOC_INTELLIGENCE_ENDPOINT=""
AZURE_DOC_INTELLIGENCE_KEY=""

# --- Google OAuth (Gmail deal inbox) ---
# Google Cloud console → Credentials → OAuth client ID → Web application.
# Authorized redirect URI: <PUBLIC_APP_URL>/oauth/gmail/return
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Encryption key for stored provider refresh tokens ---
# Generate once: openssl rand -base64 32
# Also signs the OAuth `state` parameter. Rotating it forces every user to
# reconnect Gmail.
APP_USER_CONNECTION_KEY_SECRET=""

# --- Environment mode ---
# Which environment this deployment behaves as: "production" or "preview".
# Anything else (including unset) resolves to "preview", so a forgotten value
# falls back to the Polar sandbox rather than charging a real card.
# Set APP_ENV=production in Vercel's Production scope and APP_ENV=preview in the
# Preview scope. Locally, leave it as preview.
APP_ENV="preview"

# --- Polar billing ---
# The Polar organisation is derived from APP_ENV — there is no separate switch,
# so the host and the credentials can never disagree. Each environment reads
# only its own variables; there is no fallback between them.
#
# Retired names, remove them if present: POLAR_SERVER, POLAR_ACCESS_TOKEN,
# POLAR_WEBHOOK_SECRET. They are no longer read, and the app fails loudly rather
# than silently falling back to one.
#
# Verify what a deployment actually resolved with `npm run env:check`, or the
# developer-only /environment page, which also checks each product id really
# exists in the Polar organisation being used.

# Live organisation — read only when APP_ENV=production.
POLAR_PRODUCTION_ACCESS_TOKEN=""
POLAR_PRODUCTION_WEBHOOK_SECRET=""
# Optional: the live product ids ship in src/server/polarCatalog.ts and are used
# when these are unset. Set them to reprice or repoint without a deploy.
POLAR_PRODUCTION_PRODUCT_ANGEL=""
POLAR_PRODUCTION_PRODUCT_SYNDICATE=""
POLAR_PRODUCTION_PRODUCT_INSTITUTION=""
POLAR_PRODUCTION_PRODUCT_EXTRA_SEAT=""

# Sandbox organisation — read when APP_ENV=preview (including local dev).
POLAR_SANDBOX_ACCESS_TOKEN=""
POLAR_SANDBOX_WEBHOOK_SECRET=""
# Required. Sandbox is a separate catalogue with different ids, and there is
# deliberately no fallback to the live ids: sending a live id to the sandbox API
# fails at checkout with "product doesn't exist".
POLAR_SANDBOX_PRODUCT_ANGEL=""
POLAR_SANDBOX_PRODUCT_SYNDICATE=""
POLAR_SANDBOX_PRODUCT_INSTITUTION=""
# Must be a seat-based product. A fixed-price product cannot be sold in quantity,
# so multi-seat purchases would bill for one seat while granting several.
POLAR_SANDBOX_PRODUCT_EXTRA_SEAT=""

# --- Notes ---
# Auth emails (signup confirm, password reset, invites) are sent by Supabase
# Auth, not by this app. Configure the sender in the Supabase dashboard:
# Authentication → Emails → SMTP Settings (Resend, SES, Postmark, …).
# Google sign-in is likewise configured in Supabase: Authentication → Providers
# → Google, plus URL Configuration → Redirect URLs.
